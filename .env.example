# Copy this file to .env and fill it in. The .env file is NOT versioned.
# Alternative: leave it blank and enter the key in the UI sidebar.

# Any OpenAI-compatible provider.
# Default: Gemini (Google AI Studio) — free key at https://aistudio.google.com/apikey
# Docs: https://ai.google.dev/gemini-api/docs/openai
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=

# Other examples:
# OpenAI:       LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=gpt-4o-mini
# Ollama local: LLM_BASE_URL=http://localhost:11434/v1      LLM_MODEL=qwen2.5:7b   (key: any value)
